        private void button1_Click(object sender, EventArgs e)
        {
            int courses, year;
            double transport, tuition, discount, total;

            if (!int.TryParse(txtCourses.Text, out courses) ||
                !int.TryParse(cmbStudyLevel.Text, out year) ||
                !double.TryParse(txtTransport.Text, out transport))
            {
                MessageBox.Show("Enter valid information");
                return;
            }

            tuition = courses * (year * 10 + 270 / 10.0);
            discount = courses * 5;
            total = tuition + transport - discount;

            txtResult1.Text = "Name : " + txtStudentName.Text;
            txtResult2.Text = "Id : " + txtStudentID.Text;
            txtResult3.Text = "Number Courses : " + courses;
            txtResult4.Text = "Study year : " + year;

            txtResult5.Text = "Transport Fee : " + transport;
            txtResult6.Text = "Discount : " + discount;
            txtResult7.Text = "Tuition fee : " + tuition;
            txtResult8.Text = "Final Amount : " + total;

        }

